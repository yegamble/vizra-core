# Vizra core — configuration template (VZ-FOUND-006).
#
# Every key internal/config.LoadFrom reads has exactly ONE documented home, and
# it is this file. `make config-template-check` asserts this file and
# internal/config/keys.go describe the same set, so a key added to the code
# without a template entry — or a template entry for a key nothing reads — fails
# CI.
#
# Values here are DEVELOPMENT defaults. Production refuses every one of the
# placeholder secrets below by name and by length; see
# TestProductionRefusesDevSecrets.

# development | production. Production enables the fail-secure checks.
VIZRA_MODE=development

# Scheme, host and optional port the instance is reached at. The CSRF same-origin check compares against this.
#   (required in production)
VIZRA_PUBLIC_ORIGIN=http://localhost:8080

# Address the public API server binds.
VIZRA_LISTEN_ADDR=:8080

# Address the Prometheus listener binds. Never the same as VIZRA_LISTEN_ADDR: metrics are not part of the public API contract.
VIZRA_METRICS_ADDR=127.0.0.1:9090

# Handle of the single site row in core (ADR-007). One entry; the seam exists so tenancy is not precluded.
VIZRA_SITE_HANDLE=default

# PostgreSQL DSN. The only DSN source in core (ADR-007 § The DSN source).
#   (secret: never logged, never in a queryable table; required in production)
DATABASE_URL=CHANGE-ME-generate-with-openssl-rand-base64-32

# RESP server URL (Valkey managed, or any RESP >= 7.2 server). ADR-001 Q-004.
#   (secret: never logged, never in a queryable table; required in production)
VIZRA_CACHE_URL=redis://127.0.0.1:6379/0

# Cache key namespace. Supplied by the site resolver; never hardcoded (Q-008 item 4).
VIZRA_CACHE_NAMESPACE=default

# Storage key prefix. Supplied by the site resolver; never a hardcoded root (Q-008 item 3).
VIZRA_STORAGE_PREFIX=default

# At least 32 bytes. Production refuses a known development value.
#   (secret: never logged, never in a queryable table; required in production)
VIZRA_SESSION_SECRET=CHANGE-ME-generate-with-openssl-rand-base64-32

# Key-encryption key wrapping TOTP secrets. Unset in production is a boot refusal, never a warning (ADR-003).
#   (secret: never logged, never in a queryable table; required in production)
VIZRA_MFA_KEY_KEK=CHANGE-ME-generate-with-openssl-rand-base64-32

# off | managed | external. Default off until M3 (ADR-002, Q-001).
VIZRA_SEARCH_MODE=off

# Base URL of vizra-search. Required when VIZRA_SEARCH_MODE is not off.
VIZRA_SEARCH_URL=

# Shared secret for the internal search contract. At least 32 bytes. Required when VIZRA_SEARCH_MODE is not off.
#   (secret: never logged, never in a queryable table)
VIZRA_SEARCH_HMAC_KEY=CHANGE-ME-generate-with-openssl-rand-base64-32

# Per-request timeout for internal search calls.
VIZRA_SEARCH_TIMEOUT=2s

# Comma-separated exact origins. Production refuses '*'.
VIZRA_CORS_ALLOWED_ORIGINS=

# Set to true to allow a plain-http VIZRA_PUBLIC_ORIGIN in production. Explicit by design (ADR-002).
VIZRA_ALLOW_INSECURE_PUBLIC_ORIGIN=

# Oldest queued job age above which readiness reports degraded and doctor FAILs (Q-028).
VIZRA_QUEUE_AGE_THRESHOLD=15m

# Cap on an internal search request body, enforced before the body is read.
VIZRA_MAX_INTERNAL_BODY_BYTES=1048576

# Maximum jobs a worker process runs at once.
VIZRA_WORKER_CONCURRENCY=4

# Lease duration. The heartbeat renews at lease/3.
VIZRA_JOB_LEASE=60s

# Per-job wall-clock timeout, applied as a context deadline.
VIZRA_JOB_TIMEOUT=5m

# Time allowed for in-flight requests after SIGTERM.
VIZRA_SHUTDOWN_GRACE=20s

# ---------------------------------------------------------------------------
# Development escape hatches.
#
# Production refuses to boot when any of these is set to a truthy value, BY
# NAME, with the name in the error. They are listed here commented out so an
# operator can see what exists rather than discovering one in a blog post.
# ---------------------------------------------------------------------------

# Skips authentication entirely. Development only.
# VIZRA_DEV_DISABLE_AUTH=false

# Disables the CSRF same-origin check. Development only.
# VIZRA_DEV_ALLOW_ANY_ORIGIN=false

# Boots without applying migrations. Development only.
# VIZRA_DEV_SKIP_MIGRATIONS=false

# Signs every request in as this user. Development only.
# VIZRA_DEV_AUTOLOGIN_USER=false

# Returns canned search results. Development only.
# VIZRA_DEV_FAKE_SEARCH=false

# Drops the Secure attribute from session cookies. Development only.
# VIZRA_DEV_INSECURE_COOKIES=false

# Accepts any internal HMAC signature. Development only.
# VIZRA_DEV_TRUST_ANY_HMAC=false
